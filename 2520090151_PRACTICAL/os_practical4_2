#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    int i;
    pid_t pid;
    pid_t child[3];
    int status;

    printf("Parent Process Started\n");
    printf("Parent PID: %d\n\n", getpid());

    // Create 3 child processes
    for (i = 0; i < 3; i++)
    {
        pid = fork();

        if (pid < 0)
        {
            perror("fork failed");
            exit(1);
        }

        if (pid == 0)
        {
            printf("Child %d created\n", i + 1);
            printf("Child PID: %d\n", getpid());
            printf("Child PPID: %d\n", getppid());

            sleep((i + 1) * 2);

            printf("Child %d (PID %d) finished\n\n",
                   i + 1, getpid());

            exit(i + 1);
        }

        child[i] = pid;
    }

    // Wait for specific children
    for (i = 0; i < 3; i++)
    {
        pid = waitpid(child[i], &status, 0);

        if (pid > 0 && WIFEXITED(status))
        {
            printf("Parent: Specific child PID %d completed "
                   "with exit status %d\n",
                   pid, WEXITSTATUS(status));
        }
    }

    printf("\nAll children completed.\n");
    printf("Parent process terminating.\n");

    return 0;
}
