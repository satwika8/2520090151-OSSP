#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>
#include <sys/wait.h>
#include <time.h>

#define SIZE 1000

int main()
{
    int pipefd[2];
    pid_t pid;
    int data[SIZE];

    if (pipe(pipefd) == -1)
    {
        perror("pipe");
        return 1;
    }

    pid = fork();

    if (pid < 0)
    {
        perror("fork");
        return 1;
    }

    if (pid > 0)
    {
        // Parent - Producer
        close(pipefd[0]);

        for (int i = 0; i < SIZE; i++)
        {
            data[i] = i + 1;
        }

        clock_t start = clock();

        write(pipefd[1], data, sizeof(data));

        clock_t end = clock();

        close(pipefd[1]);

        double time_taken =
            ((double)(end - start)) / CLOCKS_PER_SEC;

        printf("Producer: Sent %d integers.\n", SIZE);
        printf("Communication time: %.6f seconds\n",
               time_taken);

        wait(NULL);
    }
    else
    {
        // Child - Consumer
        close(pipefd[1]);

        int received[SIZE];

        read(pipefd[0], received, sizeof(received));

        close(pipefd[0]);

        printf("Consumer: Received %d integers.\n", SIZE);
        printf("First value: %d\n", received[0]);
        printf("Last value: %d\n", received[SIZE - 1]);

        exit(0);
    }

    return 0;
}
