#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

#define SIZE 1000000

int main() {
    int *data = malloc(SIZE * sizeof(int));

    if (data == NULL) {
        printf("Memory allocation failed\n");
        return 1;
    }

    for (int i = 0; i < SIZE; i++) {
        data[i] = 10;
    }

    printf("Before fork()\n");
    printf("PID: %d\n", getpid());
    printf("Address of data: %p\n", (void *)data);
    printf("First value: %d\n", data[0]);

    pid_t pid = fork();

    if (pid < 0) {
        printf("fork failed\n");
        free(data);
        return 1;
    }

    if (pid == 0) {
        printf("\nChild process\n");
        printf("PID: %d\n", getpid());
        printf("Address of data: %p\n", (void *)data);
        printf("Before modification: %d\n", data[0]);

        data[0] = 99;

        printf("After modification: %d\n", data[0]);
        printf("Child has its own modified copy.\n");

        free(data);
        exit(0);
    } 
    else {
        wait(NULL);

        printf("\nParent process\n");
        printf("PID: %d\n", getpid());
        printf("Address of data: %p\n", (void *)data);
        printf("Parent value: %d\n", data[0]);
        printf("Parent value remains unchanged.\n");

        free(data);
    }

    return 0;
}
