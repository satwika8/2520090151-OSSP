#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdlib.h>

int main() {
    int source, destination;
    char buffer[1024];
    ssize_t bytes;

    source = open("input.txt", O_RDONLY);

    if (source < 0) {
        perror("Error opening input file");
        return 1;
    }

    destination = open("lowlevel_output.txt",
                      O_WRONLY | O_CREAT | O_TRUNC,
                      0644);

    if (destination < 0) {
        perror("Error opening output file");
        close(source);
        return 1;
    }

    while ((bytes = read(source, buffer, sizeof(buffer))) > 0) {
        write(destination, buffer, bytes);
    }

    // Demonstrate lseek()
    lseek(source, 0, SEEK_SET);

    close(source);
    close(destination);

    printf("File copied successfully using system calls.\n");

    return 0;
}
