#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;

    printf("========================================\n");
    printf("   PROCESS CREATION AND STATE DEMO\n");
    printf("========================================\n");

    printf("\nParent process started.\n");
    printf("Parent PID  : %d\n", getpid());
    printf("Parent PPID : %d\n", getppid());

    fflush(stdout);

    pid = fork();

    if (pid < 0)
    {
        perror("fork failed");
        return 1;
    }

    else if (pid == 0)
    {
        /* Child process */
        printf("\n--- CHILD PROCESS ---\n");
        printf("Child PID   : %d\n", getpid());
        printf("Child PPID  : %d\n", getppid());
        printf("Child State : Running\n");

        fflush(stdout);

        printf("\nChild is now sleeping for 30 seconds.\n");
        printf("Observe the child using ps, top and /proc.\n");

        fflush(stdout);

        sleep(30);

        printf("\nChild has completed its work.\n");
        printf("Child State : Terminated\n");

        fflush(stdout);

        exit(0);
    }

    else
    {
        /* Parent process */
        printf("\n--- PARENT PROCESS ---\n");
        printf("Parent PID  : %d\n", getpid());
        printf("Child PID   : %d\n", pid);
        printf("Parent State: Running\n");

        fflush(stdout);

        printf("\nParent is waiting for the child.\n");
        printf("Parent State: Waiting\n");

        fflush(stdout);

        wait(NULL);

        printf("\nChild has terminated.\n");
        printf("Parent State: Running\n");

        printf("\nParent process is terminating.\n");

        fflush(stdout);
    }

    return 0;
}
