#include <stdio.h>
#include <string.h>

int main() {
    char input[200];
    char output[200];
    int i, j = 0;

    printf("Escape Sequence Parser\n");
    printf("Enter text: ");

    fgets(input, sizeof(input), stdin);

    for (i = 0; input[i] != '\0'; i++) {

        if (input[i] == '\\' && input[i + 1] != '\0') {
            i++;

            if (input[i] == 'n') {
                output[j++] = '\n';
            }
            else if (input[i] == 't') {
                output[j++] = '\t';
            }
            else if (input[i] == ' ') {
                output[j++] = ' ';
            }
            else if (input[i] == '\\') {
                output[j++] = '\\';
            }
            else if (input[i] == '"') {
                output[j++] = '"';
            }
            else if (input[i] == '$') {
                output[j++] = '$';
            }
            else {
                output[j++] = input[i];
            }
        }
        else {
            output[j++] = input[i];
        }
    }

    output[j] = '\0';

    printf("\nOriginal : %s", input);
    printf("Parsed   : %s", output);

    return 0;
}
