#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

int main(int argc, char *argv[]) {
    char *path;
    char *copy;
    char *dir;

    if (argc != 2) {
        printf("Usage: %s <command>\n", argv[0]);
        return 1;
    }

    path = getenv("PATH");

    if (path == NULL) {
        printf("PATH variable not found.\n");
        return 1;
    }

    copy = strdup(path);

    if (copy == NULL) {
        perror("strdup");
        return 1;
    }

    dir = strtok(copy, ":");

    while (dir != NULL) {
        char fullpath[512];

        snprintf(fullpath, sizeof(fullpath),
                 "%s/%s", dir, argv[1]);

        if (access(fullpath, X_OK) == 0) {
            printf("Command found: %s\n", fullpath);
            free(copy);
            return 0;
        }

        dir = strtok(NULL, ":");
    }

    printf("Command not found: %s\n", argv[1]);

    free(copy);

    return 1;
}
